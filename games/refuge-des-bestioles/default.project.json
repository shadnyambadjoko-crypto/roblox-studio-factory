{
  "name": "RefugeDesBestioles",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      }
    },
    "ServerScriptService": {
      "GameServer": {
        "$path": "src/server/GameServer.server.luau"
      }
    },
    "StarterPlayer": {
      "StarterPlayerScripts": {
        "Interface": {
          "$path": "src/client/Interface.client.luau"
        }
      }
    },
    "Workspace": {
      "$properties": {
        "FilteringEnabled": true
      },
      "SpawnLocation": {
        "$className": "SpawnLocation",
        "$properties": {
          "Anchored": true,
          "Size": [12, 1, 12],
          "Position": [0, 0.5, 0],
          "Transparency": 1,
          "CanCollide": true,
          "Duration": 0
        }
      }
    },
    "Lighting": {
      "$properties": {
        "ClockTime": 14,
        "Brightness": 3
      }
    }
  }
}

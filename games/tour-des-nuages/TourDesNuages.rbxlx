  <Item class="ReplicatedStorage" referent="1">
    <Properties>
      <string name="Name">ReplicatedStorage</string>
    </Properties>
    <Item class="Folder" referent="2">
      <Properties>
        <string name="Name">Shared</string>
      </Properties>
      <Item class="ModuleScript" referent="3">
        <Properties>
          <string name="Name">Config</string>
          <string name="Source"><![CDATA[--!strict
-- Configuration de « Tour des Nuages +1 ». Tout ce qu'on règle se trouve ici.
-- Principe : chaque pas donne +1 de puissance de saut. Plus tu cours, plus tu sautes haut,
-- plus tu montes dans la tour de nuages. Au sommet : renaissance (multiplicateur permanent).

local Config = {}

Config.DataStoreName = "TourDesNuages_v1"
Config.AutosaveInterval = 60

-- Saut
Config.BaseJumpPower = 50 -- saut normal de Roblox
Config.PowerPerJump = 10 -- 10 points de puissance = +1 JumpPower
Config.MaxJumpPower = 350
Config.StudsPerPoint = 2 -- 2 studs parcourus au sol = +1 point (avant multiplicateurs)

-- Tour
Config.FloorCount = 30
Config.CheckpointEvery = 5
Config.SpiralRadius = 30
Config.SpiralStep = 0.6 -- radians entre deux étages
Config.PlatformSize = 13

-- Hauteur à franchir pour passer de l'étage i-1 à l'étage i
function Config.FloorRise(i: number): number
	return 6 + i * 3
end

-- Puissance de saut nécessaire (avec marge) pour franchir une hauteur
function Config.JumpPowerFor(rise: number): number
	return math.sqrt(2 * 196.2 * rise) * 1.08
end

-- Étoiles gagnées la première fois qu'on atteint l'étage i dans une ascension
function Config.FloorReward(i: number): number
	return 5 * i
end
Config.SummitReward = 500

-- Bottes (amélioration achetée avec les étoiles) : +25 % de points par pas et par niveau
Config.BootsMaxLevel = 20
function Config.BootsPrice(level: number): number
	return math.floor(40 * 1.65 ^ level)
end
function Config.BootsMultiplier(level: number): number
	return 1 + 0.25 * level
end

-- Renaissance : +50 % de points par pas, cumulatif
function Config.RebirthMultiplier(rebirths: number): number
	return 1 + 0.5 * rebirths
end

function Config.JumpPowerFromPoints(points: number): number
	return math.min(Config.BaseJumpPower + points / Config.PowerPerJump, Config.MaxJumpPower)
end

-- Monétisation : remplace les 0 par les vrais ID créés dans le Creator Dashboard.
-- Tant qu'un ID vaut 0, le bouton correspondant n'apparaît pas.
Config.GamePasses = table.freeze({
	DoubleSteps = 0, -- x2 points par pas
	FastRunner = 0, -- vitesse de course 24 au lieu de 16
})
Config.FastWalkSpeed = 24

Config.DevProducts = table.freeze({
	-- [ID du produit] = points de saut donnés
	-- [123456789] = 500,
}) :: { [number]: number }

Config.DevProductLabels = table.freeze({
	-- [123456789] = "+500 saut",
}) :: { [number]: string }

return table.freeze(Config)
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="4">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="5">
      <Properties>
        <string name="Name">GameServer</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--!strict
-- Serveur de « Tour des Nuages +1 » : puissance de saut gagnée en courant, tour en spirale,
-- étoiles, bottes, checkpoints, renaissance, sauvegarde, achats.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local DataStoreService = game:GetService("DataStoreService")
local MarketplaceService = game:GetService("MarketplaceService")
local RunService = game:GetService("RunService")
local Lighting = game:GetService("Lighting")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))

---------------------------------------------------------------------
-- Remotes
---------------------------------------------------------------------
local remotes = Instance.new("Folder")
remotes.Name = "Remotes"

local function makeRemote(name: string): RemoteEvent
	local r = Instance.new("RemoteEvent")
	r.Name = name
	r.Parent = remotes
	return r
end

local BuyBoots = makeRemote("BuyBoots") -- client → serveur
local Rebirth = makeRemote("Rebirth") -- client → serveur
local Teleport = makeRemote("Teleport") -- client → serveur : ("checkpoint" | "sol")
local Notify = makeRemote("Notify") -- serveur → client : (texte)
local Celebrate = makeRemote("Celebrate") -- serveur → client : (étage)
remotes.Parent = ReplicatedStorage

---------------------------------------------------------------------
-- Données joueur
---------------------------------------------------------------------
type PlayerData = {
	points: number, -- puissance de saut accumulée (remise à 0 à la renaissance)
	stars: number,
	boots: number,
	rebirths: number,
	wins: number,
	runBest: number, -- meilleur étage de l'ascension en cours
	record: number, -- meilleur étage de tous les temps
	receipts: { string },
}

local store: DataStore? = nil
do
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(Config.DataStoreName)
	end)
	if ok then
		store = result
	else
		warn("[Nuages] DataStore indisponible (active 'Enable Studio Access to API Services' pour tester la sauvegarde) :", result)
	end
end

local sessionData: { [Player]: PlayerData } = {}
local carry: { [Player]: number } = {} -- fraction de point pas encore accordée
local lastPos: { [Player]: Vector3 } = {}
local lastRequest: { [Player]: number } = {}

local function defaultData(): PlayerData
	return { points = 0, stars = 0, boots = 0, rebirths = 0, wins = 0, runBest = 0, record = 0, receipts = {} }
end

local function num(v: any, min: number, max: number, default: number): number
	if type(v) ~= "number" or v ~= v then
		return default
	end
	return math.clamp(math.floor(v), min, max)
end

local function sanitize(raw: any): PlayerData
	local data = defaultData()
	if type(raw) ~= "table" then
		return data
	end
	data.points = num(raw.points, 0, 1e9, 0)
	data.stars = num(raw.stars, 0, 1e12, 0)
	data.boots = num(raw.boots, 0, Config.BootsMaxLevel, 0)
	data.rebirths = num(raw.rebirths, 0, 1e6, 0)
	data.wins = num(raw.wins, 0, 1e6, 0)
	data.runBest = num(raw.runBest, 0, Config.FloorCount + 1, 0)
	data.record = num(raw.record, 0, Config.FloorCount + 1, 0)
	if type(raw.receipts) == "table" then
		for _, id in raw.receipts do
			if type(id) == "string" and #data.receipts < 50 then
				table.insert(data.receipts, id)
			end
		end
	end
	return data
end

local function snapshot(data: PlayerData): PlayerData
	local copy = table.clone(data)
	copy.receipts = table.clone(data.receipts)
	return copy
end

local function loadData(player: Player): PlayerData
	if not store then
		return defaultData()
	end
	local key = "player_" .. player.UserId
	for attempt = 1, 3 do
		local ok, result = pcall(function()
			return (store :: DataStore):GetAsync(key)
		end)
		if ok then
			return sanitize(result)
		end
		warn("[Nuages] Échec du chargement (essai " .. attempt .. ") :", result)
		task.wait(attempt)
	end
	player:SetAttribute("SaveDisabled", true) -- on n'écrase pas une sauvegarde illisible
	return defaultData()
end

local function saveData(player: Player): boolean
	local data = sessionData[player]
	if not store or not data or player:GetAttribute("SaveDisabled") then
		return false
	end
	local copy = snapshot(data)
	local ok, err = pcall(function()
		(store :: DataStore):UpdateAsync("player_" .. player.UserId, function()
			return copy
		end)
	end)
	if not ok then
		warn("[Nuages] Échec de la sauvegarde :", err)
	end
	return ok
end

---------------------------------------------------------------------
-- Calculs et synchronisation
---------------------------------------------------------------------
local function multiplier(player: Player, data: PlayerData): number
	local m = Config.BootsMultiplier(data.boots) * Config.RebirthMultiplier(data.rebirths)
	if player:GetAttribute("DoubleSteps") then
		m *= 2
	end
	return m
end

local function applyHumanoid(player: Player)
	local data = sessionData[player]
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not data or not humanoid then
		return
	end
	humanoid.UseJumpPower = true
	humanoid.JumpPower = Config.JumpPowerFromPoints(data.points)
	humanoid.WalkSpeed = if player:GetAttribute("FastRunner") then Config.FastWalkSpeed else 16
end

local function syncPlayer(player: Player)
	local data = sessionData[player]
	if not data then
		return
	end
	local jump = math.floor(Config.JumpPowerFromPoints(data.points))
	local leaderstats = player:FindFirstChild("leaderstats")
	if leaderstats then
		local s = leaderstats:FindFirstChild("Saut")
		if s and s:IsA("IntValue") then
			s.Value = jump
		end
		local w = leaderstats:FindFirstChild("Sommets")
		if w and w:IsA("IntValue") then
			w.Value = data.wins
		end
	end
	player:SetAttribute("Points", data.points)
	player:SetAttribute("Jump", jump)
	player:SetAttribute("Stars", data.stars)
	player:SetAttribute("Boots", data.boots)
	player:SetAttribute("Rebirths", data.rebirths)
	player:SetAttribute("RunBest", data.runBest)
	player:SetAttribute("Record", data.record)
	player:SetAttribute("Multiplier", multiplier(player, data))
	applyHumanoid(player)
end

---------------------------------------------------------------------
-- Pass de jeu
---------------------------------------------------------------------
local function ownsPass(player: Player, passId: number): boolean
	if passId == 0 then
		return false
	end
	local ok, owns = pcall(function()
		return MarketplaceService:UserOwnsGamePassAsync(player.UserId, passId)
	end)
	return ok and owns == true
end

local function refreshPasses(player: Player)
	player:SetAttribute("DoubleSteps", ownsPass(player, Config.GamePasses.DoubleSteps))
	player:SetAttribute("FastRunner", ownsPass(player, Config.GamePasses.FastRunner))
	syncPlayer(player)
end

MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player: Player, passId: number, purchased: boolean)
	if not purchased then
		return
	end
	if passId == Config.GamePasses.DoubleSteps then
		player:SetAttribute("DoubleSteps", true)
		Notify:FireClient(player, "Merci ! Chaque pas compte double 👟👟")
	elseif passId == Config.GamePasses.FastRunner then
		player:SetAttribute("FastRunner", true)
		Notify:FireClient(player, "Merci ! Tu cours plus vite ⚡")
	end
	syncPlayer(player)
end)

---------------------------------------------------------------------
-- Produits (achats répétables) : accordés une seule fois, après sauvegarde
---------------------------------------------------------------------
MarketplaceService.ProcessReceipt = function(receipt)
	local player = Players:GetPlayerByUserId(receipt.PlayerId)
	local data = player and sessionData[player]
	local amount = Config.DevProducts[receipt.ProductId]
	if not player or not data or not amount then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local purchaseId = tostring(receipt.PurchaseId)
	if table.find(data.receipts, purchaseId) then
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end
	data.points += amount
	table.insert(data.receipts, purchaseId)
	if #data.receipts > 50 then
		table.remove(data.receipts, 1)
	end
	if store and not player:GetAttribute("SaveDisabled") and not saveData(player) then
		data.points -= amount
		local i = table.find(data.receipts, purchaseId)
		if i then
			table.remove(data.receipts, i)
		end
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	syncPlayer(player)
	Notify:FireClient(player, "+" .. amount .. " points de saut ! Merci 🙏")
	return Enum.ProductPurchaseDecision.PurchaseGranted
end

---------------------------------------------------------------------
-- Construction de la carte
---------------------------------------------------------------------
local map = Instance.new("Folder")
map.Name = "TourDesNuages"

local function part(props: { [string]: any }): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for k, v in props do
		(p :: any)[k] = v
	end
	return p
end

local function label(parent: BasePart, text: string, size: number, offset: Vector3)
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromOffset(size * 2, size)
	gui.StudsOffset = offset
	gui.AlwaysOnTop = false
	gui.MaxDistance = 120
	local t = Instance.new("TextLabel")
	t.Size = UDim2.fromScale(1, 1)
	t.BackgroundTransparency = 1
	t.TextScaled = true
	t.Font = Enum.Font.FredokaOne
	t.TextColor3 = Color3.new(1, 1, 1)
	t.TextStrokeTransparency = 0.3
	t.Text = text
	t.Parent = gui
	gui.Parent = parent
end

type Floor = { index: number, part: BasePart, checkpoint: boolean }
local floors: { Floor } = {}
local floorTop: { number } = {}

-- Sol
local ground = part({
	Name = "Prairie",
	Size = Vector3.new(500, 2, 500),
	Position = Vector3.new(0, -1, 0),
	Color = Color3.fromRGB(150, 215, 140),
	Material = Enum.Material.Grass,
})
ground.Parent = map

-- Piste de course décorative autour de la tour (on peut courir partout)
for i = 0, 35 do
	local a = i / 36 * math.pi * 2
	local tile = part({
		Name = "Piste",
		Size = Vector3.new(9, 0.2, 10),
		CFrame = CFrame.new(math.cos(a) * 75, 0.1, math.sin(a) * 75) * CFrame.Angles(0, -a, 0),
		Color = if i % 2 == 0 then Color3.fromRGB(240, 120, 110) else Color3.fromRGB(255, 160, 130),
		Material = Enum.Material.SmoothPlastic,
		CanCollide = false,
	})
	tile.Parent = map
end

-- Panneau d'accueil
local welcome = part({
	Name = "Panneau",
	Size = Vector3.new(14, 6, 0.6),
	Position = Vector3.new(0, 5, 52),
	Color = Color3.fromRGB(255, 250, 240),
	Material = Enum.Material.SmoothPlastic,
})
welcome.Parent = map
do
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 30
	local t = Instance.new("TextLabel")
	t.Size = UDim2.fromScale(1, 1)
	t.BackgroundTransparency = 1
	t.TextScaled = true
	t.Font = Enum.Font.FredokaOne
	t.TextColor3 = Color3.fromRGB(70, 90, 160)
	t.Text = "Cours = +1 saut 👟\nSaute d'étage en étage ☁️\nAtteins le sommet !"
	t.Parent = gui
	gui.Parent = welcome
end

-- Étages en spirale
local height = 0
for i = 1, Config.FloorCount do
	height += Config.FloorRise(i)
	local angle = i * Config.SpiralStep
	local hue = (0.55 + i / Config.FloorCount * 0.4) % 1
	local isCheckpoint = i % Config.CheckpointEvery == 0
	local size = Config.PlatformSize + (if isCheckpoint then 4 else 0)
	local p = part({
		Name = "Etage" .. i,
		Size = Vector3.new(size, 2, size),
		Position = Vector3.new(math.cos(angle) * Config.SpiralRadius, height - 1, math.sin(angle) * Config.SpiralRadius),
		Color = if isCheckpoint then Color3.fromRGB(255, 225, 120) else Color3.fromHSV(hue, 0.18, 1),
		Material = Enum.Material.SmoothPlastic,
	})
	p:SetAttribute("Floor", i)
	label(p, (if isCheckpoint then "⭐ " else "") .. "Étage " .. i, 3, Vector3.new(0, 4, 0))
	-- petits nuages décoratifs sous la plateforme
	for k = 1, 3 do
		local puff = part({
			Name = "Nuage",
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(6, 6, 6),
			Position = p.Position + Vector3.new((k - 2) * 4, -2, (k % 2) * 3 - 1.5),
			Color = Color3.new(1, 1, 1),
			Material = Enum.Material.SmoothPlastic,
			CanCollide = false,
			CanQuery = false,
			CanTouch = false,
		})
		puff.Parent = p
	end
	p.Parent = map
	floors[i] = { index = i, part = p, checkpoint = isCheckpoint }
	floorTop[i] = height
end

-- Sommet
local SUMMIT = Config.FloorCount + 1
local summitHeight = height + Config.FloorRise(SUMMIT)
local summit = part({
	Name = "Sommet",
	Size = Vector3.new(26, 2, 26),
	Position = Vector3.new(0, summitHeight - 1, 0),
	Color = Color3.fromRGB(255, 205, 60),
	Material = Enum.Material.Neon,
})
summit:SetAttribute("Floor", SUMMIT)
label(summit, "🏆 SOMMET 🏆", 6, Vector3.new(0, 7, 0))
summit.Parent = map
floors[SUMMIT] = { index = SUMMIT, part = summit, checkpoint = true }
floorTop[SUMMIT] = summitHeight

map.Parent = workspace

-- Ciel
do
	Lighting.ClockTime = 15
	local atmo = Instance.new("Atmosphere")
	atmo.Density = 0.25
	atmo.Haze = 1.2
	atmo.Color = Color3.fromRGB(200, 225, 255)
	atmo.Decay = Color3.fromRGB(255, 220, 240)
	atmo.Parent = Lighting
end

local function floorCFrame(index: number): CFrame
	local f = floors[index]
	return CFrame.new(f.part.Position + Vector3.new(0, 4, 0))
end

local function lastCheckpoint(runBest: number): number
	return runBest - runBest % Config.CheckpointEvery
end

---------------------------------------------------------------------
-- Arrivée sur un étage
---------------------------------------------------------------------
local function reachFloor(player: Player, index: number)
	local data = sessionData[player]
	if not data or index <= data.runBest then
		return
	end
	-- Un étage n'est validé que si on avait la puissance nécessaire pour le précédent (anti-triche simple)
	if index > data.runBest + 1 and index ~= SUMMIT then
		local needed = Config.JumpPowerFor(Config.FloorRise(index))
		if Config.JumpPowerFromPoints(data.points) < needed * 0.7 then
			return
		end
	end
	data.runBest = index
	data.record = math.max(data.record, index)
	if index == SUMMIT then
		data.stars += Config.SummitReward
		data.wins += 1
		Notify:FireClient(player, "🏆 SOMMET ! +" .. Config.SummitReward .. " ⭐ — Renaissance disponible !")
	else
		local reward = Config.FloorReward(index)
		data.stars += reward
		local msg = "Étage " .. index .. " ! +" .. reward .. " ⭐"
		if floors[index].checkpoint then
			msg ..= " — checkpoint ✅"
		end
		Notify:FireClient(player, msg)
	end
	Celebrate:FireClient(player, index)
	syncPlayer(player)
end

for _, f in floors do
	local index = f.index
	f.part.Touched:Connect(function(hit: BasePart)
		local character = hit.Parent
		local player = character and Players:GetPlayerFromCharacter(character)
		if player then
			reachFloor(player, index)
		end
	end)
end

---------------------------------------------------------------------
-- Points gagnés en courant (calcul côté serveur uniquement)
---------------------------------------------------------------------
RunService.Heartbeat:Connect(function(dt: number)
	for player, data in sessionData do
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if root and humanoid and humanoid.Health > 0 then
			local pos = root.Position
			local prev = lastPos[player]
			lastPos[player] = pos
			if prev and humanoid.FloorMaterial ~= Enum.Material.Air and humanoid.MoveDirection.Magnitude > 0.1 then
				local flat = Vector3.new(pos.X - prev.X, 0, pos.Z - prev.Z).Magnitude
				-- plafonné à la vitesse de marche : un téléport ou un exploit de vitesse ne rapporte rien
				local d = math.min(flat, humanoid.WalkSpeed * dt * 1.25)
				local gained = d / Config.StudsPerPoint * multiplier(player, data) + (carry[player] or 0)
				local whole = math.floor(gained)
				carry[player] = gained - whole
				if whole > 0 then
					data.points += whole
					player:SetAttribute("Points", data.points)
					local jump = Config.JumpPowerFromPoints(data.points)
					humanoid.JumpPower = jump
					if math.floor(jump) ~= player:GetAttribute("Jump") then
						syncPlayer(player)
					end
				end
			end
		end
	end
end)

---------------------------------------------------------------------
-- Arrivée / départ des joueurs
---------------------------------------------------------------------
local function onCharacterAdded(player: Player, character: Model)
	lastPos[player] = nil
	local humanoid = character:WaitForChild("Humanoid", 5)
	if not humanoid then
		return
	end
	applyHumanoid(player)
	local data = sessionData[player]
	if data then
		local cp = lastCheckpoint(data.runBest)
		if cp > 0 then
			task.wait(0.1)
			if character.Parent then
				character:PivotTo(floorCFrame(cp))
			end
		end
	end
end

local function onPlayerAdded(player: Player)
	local leaderstats = Instance.new("Folder")
	leaderstats.Name = "leaderstats"
	local s = Instance.new("IntValue")
	s.Name = "Saut"
	s.Parent = leaderstats
	local w = Instance.new("IntValue")
	w.Name = "Sommets"
	w.Parent = leaderstats
	leaderstats.Parent = player

	local data = loadData(player)
	if player.Parent == nil then
		return
	end
	sessionData[player] = data
	syncPlayer(player)
	task.spawn(refreshPasses, player)

	player.CharacterAdded:Connect(function(character)
		onCharacterAdded(player, character)
	end)
	if player.Character then
		task.spawn(onCharacterAdded, player, player.Character)
	end
end

local function onPlayerRemoving(player: Player)
	saveData(player)
	sessionData[player] = nil
	carry[player] = nil
	lastPos[player] = nil
	lastRequest[player] = nil
end

Players.PlayerAdded:Connect(onPlayerAdded)
Players.PlayerRemoving:Connect(onPlayerRemoving)
for _, player in Players:GetPlayers() do
	task.spawn(onPlayerAdded, player)
end

game:BindToClose(function()
	if RunService:IsStudio() and not store then
		return
	end
	local pending = 0
	for _, player in Players:GetPlayers() do
		pending += 1
		task.spawn(function()
			saveData(player)
			pending -= 1
		end)
	end
	local started = os.clock()
	while pending > 0 and os.clock() - started < 25 do
		task.wait(0.2)
	end
end)

task.spawn(function()
	while true do
		task.wait(Config.AutosaveInterval)
		for _, player in Players:GetPlayers() do
			task.spawn(saveData, player)
		end
	end
end)

---------------------------------------------------------------------
-- Remotes client → serveur (tout est vérifié ici)
---------------------------------------------------------------------
local function throttled(player: Player): boolean
	local now = os.clock()
	if now - (lastRequest[player] or 0) < 0.3 then
		return true
	end
	lastRequest[player] = now
	return false
end

BuyBoots.OnServerEvent:Connect(function(player: Player)
	local data = sessionData[player]
	if not data or throttled(player) then
		return
	end
	if data.boots >= Config.BootsMaxLevel then
		Notify:FireClient(player, "Bottes au niveau maximum ! 👢")
		return
	end
	local price = Config.BootsPrice(data.boots)
	if data.stars < price then
		Notify:FireClient(player, "Il te manque " .. (price - data.stars) .. " ⭐")
		return
	end
	data.stars -= price
	data.boots += 1
	syncPlayer(player)
	Notify:FireClient(player, "Bottes niveau " .. data.boots .. " ! Chaque pas rapporte plus 👟")
end)

Rebirth.OnServerEvent:Connect(function(player: Player)
	local data = sessionData[player]
	if not data or throttled(player) then
		return
	end
	if data.runBest < SUMMIT then
		Notify:FireClient(player, "Atteins d'abord le sommet 🏆")
		return
	end
	data.rebirths += 1
	data.points = 0
	data.runBest = 0
	carry[player] = 0
	syncPlayer(player)
	local character = player.Character
	if character then
		character:PivotTo(CFrame.new(0, 5, 40))
	end
	Notify:FireClient(player, "Renaissance " .. data.rebirths .. " ! Tes pas valent maintenant x" .. Config.RebirthMultiplier(data.rebirths) .. " 🌈")
end)

Teleport.OnServerEvent:Connect(function(player: Player, where: unknown)
	local data = sessionData[player]
	local character = player.Character
	if not data or not character or throttled(player) then
		return
	end
	if where == "sol" then
		character:PivotTo(CFrame.new(0, 5, 40))
	elseif where == "checkpoint" then
		local cp = lastCheckpoint(data.runBest)
		if cp == 0 then
			Notify:FireClient(player, "Pas encore de checkpoint : atteins l'étage " .. Config.CheckpointEvery .. " ⭐")
			return
		end
		character:PivotTo(floorCFrame(cp))
	end
	lastPos[player] = nil
end)
]]></string>
      </Properties>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="6">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="7">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="8">
        <Properties>
          <string name="Name">Interface</string>
          <string name="Source"><![CDATA[--!strict
-- Interface de « Tour des Nuages +1 » : saut, étoiles, objectif suivant, bottes, checkpoint,
-- renaissance, boutique, notifications et petits « +1 » qui s'envolent.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local MarketplaceService = game:GetService("MarketplaceService")
local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local remotes = ReplicatedStorage:WaitForChild("Remotes")
local BuyBoots = remotes:WaitForChild("BuyBoots") :: RemoteEvent
local Rebirth = remotes:WaitForChild("Rebirth") :: RemoteEvent
local Teleport = remotes:WaitForChild("Teleport") :: RemoteEvent
local Notify = remotes:WaitForChild("Notify") :: RemoteEvent
local Celebrate = remotes:WaitForChild("Celebrate") :: RemoteEvent

local player = Players.LocalPlayer
local FONT = Enum.Font.FredokaOne
local SKY = Color3.fromRGB(110, 160, 255)
local WHITE = Color3.fromRGB(255, 255, 255)
local INK = Color3.fromRGB(40, 55, 110)
local GOLD = Color3.fromRGB(255, 205, 60)
local SUMMIT = Config.FloorCount + 1

local function corner(parent: Instance, radius: number)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, radius)
	c.Parent = parent
end

local function stroke(parent: Instance, color: Color3?)
	local s = Instance.new("UIStroke")
	s.Thickness = 3
	s.Color = color or INK
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	s.Parent = parent
end

local function formatNumber(n: number): string
	local s = tostring(math.floor(n))
	local out = s:reverse():gsub("(%d%d%d)", "%1 "):reverse()
	return (out:gsub("^ ", ""))
end

local function attr(name: string): number
	return (player:GetAttribute(name) :: number?) or 0
end

local screen = Instance.new("ScreenGui")
screen.Name = "NuagesUI"
screen.ResetOnSpawn = false

local function textLabel(parent: Instance, size: UDim2, pos: UDim2, color: Color3): TextLabel
	local t = Instance.new("TextLabel")
	t.Size = size
	t.Position = pos
	t.BackgroundTransparency = 1
	t.Font = FONT
	t.TextScaled = true
	t.TextColor3 = color
	t.Parent = parent
	return t
end

local function button(parent: Instance, text: string, color: Color3, size: UDim2): TextButton
	local b = Instance.new("TextButton")
	b.Size = size
	b.BackgroundColor3 = color
	b.Font = FONT
	b.TextScaled = true
	b.TextColor3 = INK
	b.Text = text
	b.AutoButtonColor = true
	corner(b, 12)
	stroke(b)
	local pad = Instance.new("UIPadding")
	pad.PaddingLeft = UDim.new(0, 8)
	pad.PaddingRight = UDim.new(0, 8)
	pad.PaddingTop = UDim.new(0, 6)
	pad.PaddingBottom = UDim.new(0, 6)
	pad.Parent = b
	b.Parent = parent
	return b
end

---------------------------------------------------------------------
-- Haut de l'écran : saut + étoiles
---------------------------------------------------------------------
local top = Instance.new("Frame")
top.Size = UDim2.fromOffset(340, 58)
top.AnchorPoint = Vector2.new(0.5, 0)
top.Position = UDim2.new(0.5, 0, 0, 10)
top.BackgroundColor3 = WHITE
corner(top, 14)
stroke(top)
top.Parent = screen

local jumpLabel = textLabel(top, UDim2.new(0.55, -8, 1, -14), UDim2.fromOffset(8, 7), INK)
local starLabel = textLabel(top, UDim2.new(0.45, -8, 1, -14), UDim2.new(0.55, 0, 0, 7), Color3.fromRGB(200, 140, 0))

-- Objectif : prochain étage
local goal = Instance.new("Frame")
goal.Size = UDim2.fromOffset(340, 40)
goal.AnchorPoint = Vector2.new(0.5, 0)
goal.Position = UDim2.new(0.5, 0, 0, 74)
goal.BackgroundColor3 = INK
goal.BackgroundTransparency = 0.2
corner(goal, 10)
goal.Parent = screen
local goalFill = Instance.new("Frame")
goalFill.Size = UDim2.fromScale(0, 1)
goalFill.BackgroundColor3 = SKY
goalFill.BorderSizePixel = 0
corner(goalFill, 10)
goalFill.Parent = goal
local goalText = textLabel(goal, UDim2.new(1, -16, 1, -10), UDim2.fromOffset(8, 5), WHITE)
goalText.ZIndex = 2

---------------------------------------------------------------------
-- Bas de l'écran : actions
---------------------------------------------------------------------
local bar = Instance.new("Frame")
bar.Size = UDim2.new(0, 0, 0, 56)
bar.AutomaticSize = Enum.AutomaticSize.X
bar.AnchorPoint = Vector2.new(0.5, 1)
bar.Position = UDim2.new(0.5, 0, 1, -14)
bar.BackgroundTransparency = 1
bar.Parent = screen
local layout = Instance.new("UIListLayout")
layout.FillDirection = Enum.FillDirection.Horizontal
layout.Padding = UDim.new(0, 8)
layout.Parent = bar

local bootsButton = button(bar, "", WHITE, UDim2.fromOffset(190, 56))
local checkpointButton = button(bar, "⬆️ Checkpoint", WHITE, UDim2.fromOffset(140, 56))
local groundButton = button(bar, "⬇️ Sol", WHITE, UDim2.fromOffset(90, 56))
local rebirthButton = button(bar, "🌈 Renaissance", GOLD, UDim2.fromOffset(170, 56))

bootsButton.Activated:Connect(function()
	BuyBoots:FireServer()
end)
checkpointButton.Activated:Connect(function()
	Teleport:FireServer("checkpoint")
end)
groundButton.Activated:Connect(function()
	Teleport:FireServer("sol")
end)
rebirthButton.Activated:Connect(function()
	Rebirth:FireServer()
end)

-- Statistiques à gauche
local stats = textLabel(screen, UDim2.fromOffset(200, 70), UDim2.new(0, 12, 0.5, -35), INK)
stats.TextXAlignment = Enum.TextXAlignment.Left
stats.TextStrokeColor3 = WHITE
stats.TextStrokeTransparency = 0.2

---------------------------------------------------------------------
-- Rafraîchissement
---------------------------------------------------------------------
local function refresh()
	local jump = attr("Jump")
	local stars = attr("Stars")
	local boots = attr("Boots")
	local runBest = attr("RunBest")
	jumpLabel.Text = "👟 Saut " .. formatNumber(jump)
	starLabel.Text = "⭐ " .. formatNumber(stars)

	if runBest >= SUMMIT then
		goalText.Text = "🏆 Sommet atteint ! Renaissance = x" .. Config.RebirthMultiplier(attr("Rebirths") + 1)
		goalFill.Size = UDim2.fromScale(1, 1)
	else
		local nextFloor = runBest + 1
		local needed = math.ceil(Config.JumpPowerFor(Config.FloorRise(nextFloor)))
		local name = if nextFloor == SUMMIT then "Sommet" else "Étage " .. nextFloor
		if jump >= needed then
			goalText.Text = name .. " : tu peux sauter ! ⬆️"
		else
			goalText.Text = name .. " : saut " .. needed .. " (cours encore !)"
		end
		goalFill.Size = UDim2.fromScale(math.clamp((jump - Config.BaseJumpPower) / math.max(needed - Config.BaseJumpPower, 1), 0, 1), 1)
	end

	if boots >= Config.BootsMaxLevel then
		bootsButton.Text = "👢 Bottes MAX"
	else
		bootsButton.Text = "👢 Bottes " .. (boots + 1) .. " : " .. formatNumber(Config.BootsPrice(boots)) .. " ⭐"
	end
	bootsButton.BackgroundColor3 = if boots < Config.BootsMaxLevel and stars >= Config.BootsPrice(boots) then Color3.fromRGB(190, 240, 170) else WHITE
	rebirthButton.Visible = runBest >= SUMMIT
	checkpointButton.Visible = runBest >= Config.CheckpointEvery

	stats.Text = string.format(
		"Record : étage %d\nMultiplicateur : x%.2f\nRenaissances : %d",
		math.min(attr("Record"), Config.FloorCount),
		attr("Multiplier"),
		attr("Rebirths")
	)
end

for _, name in { "Jump", "Stars", "Boots", "RunBest", "Record", "Rebirths", "Multiplier" } do
	player:GetAttributeChangedSignal(name):Connect(refresh)
end
refresh()

---------------------------------------------------------------------
-- Petits « +N » qui s'envolent quand on gagne des points en courant
---------------------------------------------------------------------
local lastPoints = attr("Points")
local pending = 0
player:GetAttributeChangedSignal("Points"):Connect(function()
	local p = attr("Points")
	if p > lastPoints then
		pending += p - lastPoints
	end
	lastPoints = p
end)

task.spawn(function()
	local rng = Random.new()
	while true do
		task.wait(0.35)
		if pending > 0 then
			local amount = pending
			pending = 0
			local pop = textLabel(screen, UDim2.fromOffset(90, 34), UDim2.new(0.5, rng:NextInteger(-120, 80), 1, -110), Color3.fromRGB(90, 200, 90))
			pop.Text = "+" .. formatNumber(amount)
			pop.TextStrokeTransparency = 0.2
			pop.TextStrokeColor3 = WHITE
			local tween = TweenService:Create(pop, TweenInfo.new(0.9), {
				Position = pop.Position - UDim2.fromOffset(0, 70),
				TextTransparency = 1,
				TextStrokeTransparency = 1,
			})
			tween:Play()
			tween.Completed:Connect(function()
				pop:Destroy()
			end)
		end
	end
end)

---------------------------------------------------------------------
-- Boutique (seulement si des ID sont configurés)
---------------------------------------------------------------------
type ShopItem = { label: string, buy: () -> () }
local shopItems: { ShopItem } = {}
if Config.GamePasses.DoubleSteps ~= 0 then
	table.insert(shopItems, {
		label = "👟👟 Pas x2",
		buy = function()
			MarketplaceService:PromptGamePassPurchase(player, Config.GamePasses.DoubleSteps)
		end,
	})
end
if Config.GamePasses.FastRunner ~= 0 then
	table.insert(shopItems, {
		label = "⚡ Course rapide",
		buy = function()
			MarketplaceService:PromptGamePassPurchase(player, Config.GamePasses.FastRunner)
		end,
	})
end
for productId, text in Config.DevProductLabels do
	table.insert(shopItems, {
		label = text,
		buy = function()
			MarketplaceService:PromptProductPurchase(player, productId)
		end,
	})
end

if #shopItems > 0 then
	local shopButton = button(screen, "🛒 Boutique", GOLD, UDim2.fromOffset(130, 48))
	shopButton.Position = UDim2.new(1, -142, 0, 12)
	local panel = Instance.new("Frame")
	panel.Size = UDim2.fromOffset(220, 0)
	panel.AutomaticSize = Enum.AutomaticSize.Y
	panel.Position = UDim2.new(1, -232, 0, 68)
	panel.BackgroundColor3 = WHITE
	panel.Visible = false
	corner(panel, 12)
	stroke(panel)
	panel.Parent = screen
	local list = Instance.new("UIListLayout")
	list.Padding = UDim.new(0, 6)
	list.Parent = panel
	local panelPad = Instance.new("UIPadding")
	for _, side in { "PaddingTop", "PaddingBottom", "PaddingLeft", "PaddingRight" } do
		(panelPad :: any)[side] = UDim.new(0, 8)
	end
	panelPad.Parent = panel
	for _, item in shopItems do
		local b = button(panel, item.label, SKY, UDim2.new(1, 0, 0, 44))
		b.TextColor3 = WHITE
		b.Activated:Connect(item.buy)
	end
	shopButton.Activated:Connect(function()
		panel.Visible = not panel.Visible
	end)
end

---------------------------------------------------------------------
-- Notifications et célébrations
---------------------------------------------------------------------
local toast = textLabel(screen, UDim2.fromOffset(420, 44), UDim2.new(0.5, 0, 0, 122), WHITE)
toast.AnchorPoint = Vector2.new(0.5, 0)
toast.BackgroundTransparency = 0.15
toast.BackgroundColor3 = INK
toast.Visible = false
corner(toast, 10)

local toastToken = 0
local function showToast(text: string, duration: number)
	toastToken += 1
	local token = toastToken
	toast.Text = text
	toast.Visible = true
	task.delay(duration, function()
		if token == toastToken then
			toast.Visible = false
		end
	end)
end
Notify.OnClientEvent:Connect(function(text: string)
	showToast(text, 2.4)
end)

Celebrate.OnClientEvent:Connect(function(floor: number)
	local big = textLabel(screen, UDim2.fromOffset(500, 90), UDim2.fromScale(0.5, 0.35), GOLD)
	big.AnchorPoint = Vector2.new(0.5, 0.5)
	big.TextStrokeTransparency = 0
	big.TextStrokeColor3 = INK
	big.Text = if floor >= SUMMIT then "🏆 SOMMET ! 🏆" else "ÉTAGE " .. floor .. " !"
	big.Size = UDim2.fromOffset(250, 45)
	local grow = TweenService:Create(big, TweenInfo.new(0.35, Enum.EasingStyle.Back), { Size = UDim2.fromOffset(500, 90) })
	grow:Play()
	task.delay(1.1, function()
		local fade = TweenService:Create(big, TweenInfo.new(0.4), { TextTransparency = 1, TextStrokeTransparency = 1 })
		fade:Play()
		fade.Completed:Connect(function()
			big:Destroy()
		end)
	end)
end)

screen.Parent = player:WaitForChild("PlayerGui")

task.delay(2, function()
	if toastToken == 0 then
		showToast("Cours partout : chaque pas = +1 saut ! 👟☁️", 5)
	end
end)
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="Workspace" referent="9">
    <Properties>
      <string name="Name">Workspace</string>
      <bool name="FilteringEnabled">true</bool>
      <bool name="NeedsPivotMigration">false</bool>
    </Properties>
    <Item class="SpawnLocation" referent="10">
      <Properties>
        <string name="Name">SpawnLocation</string>
        <bool name="Anchored">true</bool>
        <bool name="CanCollide">true</bool>
        <int name="Duration">0</int>
        <Vector3 name="Position">
          <X>0</X>
          <Y>0.5</Y>
          <Z>0</Z>
        </Vector3>
        <Vector3 name="size">
          <X>12</X>
          <Y>1</Y>
          <Z>12</Z>
        </Vector3>
        <float name="Transparency">1</float>
      </Properties>
    </Item>
  </Item>
</roblox>